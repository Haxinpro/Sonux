{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonux",
  "version": "1.1.0",
  "identifier": "dev.sonux.audio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Sonux",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/icons/**",
          "/usr/share/pixmaps/**",
          "/var/lib/flatpak/exports/share/icons/**",
          "$HOME/.local/share/icons/**",
          "$HOME/.local/share/flatpak/exports/share/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "copyright": "Copyright Sink and Sonux contributors",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/GPL-3.0.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../third_party/licenses/APACHE-2.0.txt": "licenses/APACHE-2.0.txt",
      "../src/styles/fonts/LICENSE.txt": "licenses/FIRA_CODE_LICENSE.txt",
      "../src-tauri/assets/test-audio/LICENSES.md": "licenses/TEST_AUDIO_LICENSES.md",
      "../third_party/spatial/licenses/AALTO_HRTF_ATTRIBUTION.md": "licenses/AALTO_HRTF_ATTRIBUTION.md"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libfftw3-single3",
          "libmysofa1",
          "pulseaudio-utils",
          "pipewire-pulse",
          "wireplumber"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator3.so.1()(64bit)",
          "pulseaudio-utils",
          "pipewire-pulseaudio",
          "wireplumber"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
